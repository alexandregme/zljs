{
  "name": "@alexandregme/zljs",
  "version": "0.3.11",
  "description": "Opinionated, accessible React component library for enterprise apps (Next.js, Tailwind CSS v4).",
  "keywords": [
    "react",
    "nextjs",
    "components",
    "ui",
    "tailwindcss",
    "design-system"
  ],
  "license": "MIT",
  "author": "Alexandre Mendes",
  "homepage": "https://zljs.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandregme/zljs.git"
  },
  "bugs": {
    "url": "https://github.com/alexandregme/zljs/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js"
    },
    "./rhf": {
      "types": "./dist/rhf/index.d.ts",
      "import": "./dist/rhf/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "lint": "tsc --noEmit && eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "build": "storybook build",
    "storybook": "storybook dev -p 6006",
    "test:watch": "vitest --coverage",
    "test:coverage": "vitest run --coverage",
    "eslint": "eslint ./ --color --fix",
    "prettier": "prettier --write .",
    "stylelint": "stylelint '**/*.{css,scss}' --allow-empty-input",
    "fresh": "rm -rf node_modules && rm -f pnpm-lock.yaml && pnpm install",
    "prepare": "husky",
    "agent:dev": "pnpm --filter @zljs/agent dev",
    "build:lib": "tsup",
    "prepublishOnly": "pnpm build:lib"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "ag-grid-community": "^35.0.0",
    "ag-grid-react": "^35.0.0",
    "axios": "^1.13.5",
    "lucide-react": "^0.563.0",
    "react-hook-form": "^7.70.0",
    "react-icons": "^5.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "zod": "^4.3.5",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.39.1",
    "@storybook/react-vite": "^10.2.8",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-storybook": "10.1.11",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.2.7",
    "next": "^16.1.6",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "storybook": "^10.4.6",
    "stylelint": "^16.26.1",
    "tailwindcss": "^4.1.18",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^7.2.7",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "@reduxjs/toolkit": "^2.0.0",
    "next": ">=16.0.0",
    "next-auth": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md}": "pnpm lint"
  }
}
